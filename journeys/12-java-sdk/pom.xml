<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>land.tx3.e2e</groupId>
  <artifactId>java-sdk-journey</artifactId>
  <version>0.0.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tx3.sdk.version>0.15.0</tx3.sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>land.tx3.generated</groupId>
      <artifactId>demo-client</artifactId>
      <version>0.0.0-SNAPSHOT</version>
    </dependency>
    <!-- Direct so the snapshot override also wins over the generated POM's release default. -->
    <dependency>
      <groupId>land.tx3</groupId>
      <artifactId>tx3-sdk</artifactId>
      <version>${tx3.sdk.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
    </plugins>
  </build>
</project>
